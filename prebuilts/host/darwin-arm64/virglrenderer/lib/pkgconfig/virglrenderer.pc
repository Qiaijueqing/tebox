prefix=/Users/myt/Desktop/work/GKI/prebuilts/host/darwin-arm64/virglrenderer
includedir=${prefix}/include
libdir=${prefix}/lib

Name: virglrenderer
Description: virgl GL renderer
Version: 1.3.0
Requires.private: epoxy >=  1.5.4
Libs: -L${libdir} -lvirglrenderer
Libs.private: -lm -framework CoreFoundation -framework CoreMedia -framework CoreVideo -framework VideoToolbox -framework CoreFoundation -framework CoreMedia -framework CoreVideo -framework VideoToolbox
Cflags: -I${includedir}/virgl -DVIRGL_RENDERER_UNSTABLE_APIS=1
