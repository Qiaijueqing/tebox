ro.hardware=ranchu
# This QEMU device runs a single 64-bit zygote.
ro.zygote=zygote64
ro.product.cpu.abilist=arm64-v8a
ro.product.cpu.abilist64=arm64-v8a
ro.product.cpu.abilist32=
persist.sys.glamor=1
debug.renderengine.backend=skiaglthreaded
debug.renderengine.graphite=0
debug.renderengine.vulkan=0
ro.surface_flinger.supports_background_blur=false

ro.sf.lcd_density=420

# Dual-SIM soft radio (slot1 T-Mobile US 5G, slot2 Vodafone DE 4G).
persist.radio.multisim.config=dsds
ro.telephony.sim.count=2
ro.vendor.api_level=202404

# Soft WiFi HAL chip country (US).
ro.wifi.channels=
wifi.interface=wlan0

# Device heap configuration for the default 4 GiB QEMU guest.
dalvik.vm.heapstartsize=16m
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=2m
dalvik.vm.heapmaxfree=8m

# The GSI's system/build.prop lists only AVC vendor Codec2 components
# (debug.stagefright.ccodec=1); keep every one, c2.tebox.hevc.decoder too.
debug.stagefright.ccodec=4

# Vendor AudioService builds (OriginOS) take the stream volume ranges from
# these; a device's vendor partition sets them. Without them music, alarm and system have
# a 0..0 range and SystemUI's volume slider divides by zero.
ro.config.media_vol_steps=15
ro.config.media_vol_default=8
ro.config.alarm_vol_steps=7
ro.config.system_vol_steps=7

# Flyme's NFC service (GdxNfcNci) loads its own Goodix JNI only for a Goodix
# chip, which a Meizu vendor reports here; otherwise it loads the AOSP
# libnfc_nci_jni, whose natives do not match its classes, and aborts in a loop.
persist.nfc_cfg.nfc_chip_type=gsn

# The GSI imports hw/mediaserver.64bit_${ro.mediaserver.64b.enable}.rc while
# init parses its scripts, so this must be a build property: without it the
# media service runs mediaserver32, which this 64-bit-only guest cannot run,
# and media.player / media.resource_manager never appear (MediaCodec clients
# such as scrcpy wait forever).
ro.mediaserver.64b.enable=true
