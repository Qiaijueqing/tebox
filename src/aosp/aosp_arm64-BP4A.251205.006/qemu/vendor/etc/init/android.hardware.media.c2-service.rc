service vendor.media-c2-mesa /vendor/bin/hw/android.hardware.media.c2-service
    class hal
    user mediacodec
    group mediacodec drmrpc
    ioprio rt 4
    seclabel u:r:hal_keymint_system:s0
    setenv LIBGL_DRIVERS_PATH /vendor/lib64/dri
    setenv GBM_BACKENDS_PATH /vendor/lib64/gbm
    setenv GKI_MESA_DIRECT_IMPORT 1
    interface aidl android.hardware.media.c2.IComponentStore/default
