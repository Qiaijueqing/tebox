<?xml version="1.0" encoding="utf-8"?>
<!-- Vendor Mesa / VirGL hardware AVC codecs (GKI QEMU). -->
<MediaCodecs>
    <Encoders>
        <MediaCodec name="c2.mesa.avc.encoder" type="video/avc">
            <Alias name="OMX.mesa.avc.encoder"/>
            <Limit name="size" min="16x16" max="4096x4096"/>
            <Limit name="alignment" value="2x2"/>
            <Limit name="block-size" value="16x16"/>
            <Limit name="blocks-per-second" range="1-244140"/>
            <Limit name="bitrate" range="1-50000000"/>
            <Feature name="intra-refresh"/>
        </MediaCodec>
    </Encoders>
</MediaCodecs>
