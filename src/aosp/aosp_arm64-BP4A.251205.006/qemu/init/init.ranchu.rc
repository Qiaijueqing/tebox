on early-init
    setprop ro.hardware ranchu
    setprop ro.zygote zygote64
    setprop debug.renderengine.backend skiaglthreaded
    setprop ro.vendor.build.version.sdk 36
    setprop ro.vendor.build.security_patch 2025-12-05
    setprop dalvik.vm.dex2oat64 true
    # The GSI already exposes its software C2 AIDL store. Its HIDL input
    # surface fallback requires an OMX HAL which this vendor does not have.
    setprop media.c2.hal.selection aidl
    # -1 creates the framework's in-process GraphicBufferSource when the
    # component store does not implement its own input surface.
    setprop debug.stagefright.c2inputsurface -1
    # /data is mounted by initramfs before early_hal starts KeyMint.
    mkdir /data/misc/qemu-keymint 0700 root root
    restorecon_recursive /data/misc/qemu-keymint
    # Soft wificond is bind-mounted from initramfs (rootfs label). Relabel
    # before class main so init can start it as wificond_exec.
    restorecon /system/bin/wificond

on init
    restorecon_recursive /dev/dri

# The initramfs already mounts unencrypted userdata; no vold decrypt event follows.
on post-fs-data
    trigger nonencrypted

on property:sys.boot_completed=1
    # settings is a shell script, not an init service executable. Use the shell
    # domain explicitly so init can launch it and the plugged-in VM stays awake.
    exec_background u:r:shell:s0 shell shell -- /system/bin/sh /system/bin/settings put global stay_on_while_plugged_in 1

# Opt-in local serial diagnostics for this bring-up image.
on init && property:ro.boot.qemu_debug=1
    chcon u:object_r:console_device:s0 /dev/hvc0
    start qemu-debug-shell

service qemu-debug-shell /system/bin/sh
    disabled
    console hvc0
    user root
    group root shell log readproc
    seclabel u:r:shell:s0

on early-boot
    start vendor.health-default

on boot
    start vendor.health-default

# TCP ADB when the host launcher passes androidboot.qemu_adb=1 (default).
# Initramfs clears ro.adb.secure so adbd skips RSA; use the GSI adbd binary.
on boot && property:ro.boot.qemu_adb=1
    # QEMU user networking forwards to 10.0.2.15, while this GSI's fake Wi-Fi
    # stack does not run DHCP on the separate virtio Ethernet interface.
    exec u:r:vendor_init:s0 root root -- /system/bin/ip link set eth0 up
    exec u:r:vendor_init:s0 root root -- /system/bin/ip addr replace 10.0.2.15/24 dev eth0
    setprop service.adb.tcp.port 5555
    setprop sys.usb.config adb
    start adbd

on property:sys.boot_completed=1 && property:ro.boot.qemu_adb=1
    # Android netd replaces the initial Linux routing rules. Restrict this
    # extra lookup to the QEMU host subnet so TCP debugging can send replies.
    exec u:r:vendor_init:s0 root root -- /system/bin/ip rule add priority 9000 to 10.0.2.0/24 lookup main
    exec_background u:r:shell:s0 shell shell -- /system/bin/sh /system/bin/settings put global adb_enabled 1
